config BR2_PACKAGE_CAT_GIF
    bool "cat_gif"
    depends on !BR2_STATIC_LIBS
    depends on BR2_USE_WCHAR
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on BR2_INSTALL_LIBSTDCPP
    depends on BR2_PACKAGE_SDL3_KMSDRM
    select BR2_PACKAGE_SDL3_IMAGE
    help
        This app displays gifs (of cats, hopefully) on a
        screen available through some renderer SDL3 may
        use. gifs are sourced from a user-config'd directory

        This app leaves the choice of SDL renderer up to the
        configurer. For a pi3b+, we recommend enabling
        BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4.
        For other platforms: you're on your own getting SDL3 a render to use.
    
comment "cat_gif, b/c of SDL3: needs dynamic libs, threads, cpp17, sdl-kmsdrm and wchar support"
    depends on BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_SDL3_KMSDRM